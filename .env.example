# ===== DATABAZA (Railway → Postgres; në Railway vendos: ${{Postgres.DATABASE_URL}}) =====
DATABASE_URL=postgresql://postgres:password@localhost:5432/bledi_fit

# Regjistrimi: si parazgjedhje lejohet VETËM llogaria e parë. Vendos "true" për të lejuar të tjerë.
ALLOW_SIGNUP=false

# ===== AI COACH (console.anthropic.com → API Keys) =====
ANTHROPIC_API_KEY=sk-ant-...                    # SEKRET – vetëm në server
ANTHROPIC_MODEL=claude-sonnet-5-5               # opsional
AI_DAILY_LIMIT=60                               # opsional

# ===== WEB PUSH (gjenero me: npx web-push generate-vapid-keys) =====
NEXT_PUBLIC_VAPID_PUBLIC_KEY=B...
VAPID_PRIVATE_KEY=...                           # SEKRET
VAPID_SUBJECT=mailto:emaili-yt@example.com

# ===== CRON manual (opsional – kujtuesit dërgohen automatikisht nga serveri) =====
CRON_SECRET=...
