# ===== SUPABASE (Project Settings → API) =====
NEXT_PUBLIC_SUPABASE_URL=https://XXXXXXXX.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...            # publik, i sigurt për frontend (mbrohet me RLS)
SUPABASE_SERVICE_ROLE_KEY=eyJ...                # SEKRET – vetëm në server (cron i njoftimeve)

# ===== AI COACH (console.anthropic.com → API Keys) =====
ANTHROPIC_API_KEY=sk-ant-...                    # SEKRET – vetëm në server
ANTHROPIC_MODEL=claude-sonnet-5-5               # opsional
AI_DAILY_LIMIT=60                               # opsional: maksimumi i kërkesave AI në ditë për përdorues

# ===== WEB PUSH (gjenero me: npx web-push generate-vapid-keys) =====
NEXT_PUBLIC_VAPID_PUBLIC_KEY=B...
VAPID_PRIVATE_KEY=...                           # SEKRET
VAPID_SUBJECT=mailto:info@bledi-isp.com

# ===== CRON (çdo varg i gjatë i rastësishëm, p.sh. openssl rand -hex 32) =====
CRON_SECRET=...
